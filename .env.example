# Copied to ~/.config/ai-intake-mcp/.env by install.sh — not read from here at runtime, and never
# committed with real values (see docs/setup.md "Set up Jira credentials"). This template only
# holds placeholders.

JIRA_SITE_URL=https://your-site.atlassian.net

# Have an Atlassian API token? Fill these in
# (https://id.atlassian.com/manage-profile/security/api-tokens):
JIRA_INTAKE_EMAIL=you@your-domain.com
JIRA_INTAKE_API_TOKEN=your-api-token-here

# No API token available (e.g. blocked by org policy)? Delete/blank out JIRA_INTAKE_API_TOKEN
# above instead — ai-intake-mcp then falls back to a browser session cookie (Chrome/Chromium on
# Linux only for now): a fresh cookie is extracted straight from your browser's cookie store on
# every call, never written to disk. Requires a live, unlocked desktop session with the OS keyring
# (libsecret/GNOME Keyring) available, and you logged into Jira in that browser.

# Optional overrides — only needed if your board's native status names differ from the defaults,
# or you want to pin one browser for the cookie fallback above:
# TRACKER_NATIVE_STATUS_IN_PROGRESS=In Progress
# TRACKER_NATIVE_STATUS_CODE_REVIEW=Code Review
# JIRA_COOKIE_BROWSER=chrome
